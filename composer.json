{
    "name": "everstar-asia/miraicards-login",
    "description": "Secure OpenID Connect login for Laravel applications using MiraiCards",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "lcobucci/jwt": "^5.6"
    },
    "require-dev": {
        "laravel/pint": "^1",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "EverstarAsia\\MiraiCardsLogin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EverstarAsia\\MiraiCardsLogin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EverstarAsia\\MiraiCardsLogin\\MiraiCardsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
